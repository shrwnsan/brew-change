#!/usr/bin/env bash
# Enhanced brew-changelog with actual release content display
# Shows changelog information for Homebrew packages with formatted output
# Refactored for better maintainability and parallel processing

set -euo pipefail

# Version information
readonly VERSION="1.18.1"

# ---------------------------------------------------------------------------
# Early validation: handle side-effect-free options before any brew/auth/cache
# initialization. These paths exit immediately and never touch the network,
# Homebrew prefix, dependency checks, or module sourcing.
# ---------------------------------------------------------------------------

# Save original arguments before any parsing
ORIGINAL_ARGS=("$@")

# Usage text (heredoc, no external deps)
usage() {
	cat << 'EOF'
Usage: brew-change [OPTIONS] [PACKAGE ...]

Shows changelog information for Homebrew packages.

Arguments:
  PACKAGE ...    Show changelog for one or more specific packages

Options:
  -a, --all            Show detailed changelog for all outdated packages (parallel)
  -v, --verbose        Show outdated packages with version numbers (like 'brew outdated -v')
  -b, --id-breaking    Highlight packages with breaking changes (implies -a)
  -u, --upgrade        Trusted update workflow (implies -a, -b). On a
                        terminal this runs the interactive dashboard
                        (review, select, upgrade); use --plain for the
                        previous prompt flow. Piped runs stay plain and
                        never prompt or upgrade.
                        Use --dry-run to preview without executing
  -n, --dry-run        Preview upgrade without executing (use with -u)
      --fresh          Re-probe all evidence this run: clears only the HTTP
                        response cache first (other caches are kept)
      --plain          Use the previous prompt flow for -u instead of the
                        dashboard (also via BREW_CHANGE_PLAIN=1; the flag
                        beats the environment variable)
      --dashboard      No-op since v1.14.0: the dashboard is now the default
                        for -u runs on a terminal. Accepted (with
                        BREW_CHANGE_DASHBOARD=1) for compatibility with
                        the former opt-in; ignored when stdout is not a
                        terminal
  -h, --help           Show this help message
      --version        Show version information

Commands:
  export               Print the last assessment export to stdout

If no PACKAGE is specified and no flags, shows simple list like 'brew outdated'.

Trusted update workflow (-u; no account or setup needed):
  Check    inventory of outdated packages (like 'brew outdated')
  Review   [r]eview each package's source and reasons before anything runs
  Upgrade  nothing upgrades until you confirm the exact plan; quit any time

Examples:
  brew-change -u                # Trusted update workflow: interactive dashboard
  brew-change -u --plain        # Trusted update workflow with the previous prompt flow
  brew-change -u --dry-run      # Preview the no-signal plan (no execution)
  brew-change node              # Show changelog for node package
  brew-change node python git   # Show changelogs for multiple packages
  brew-change -a                # Show detailed changelogs for all outdated packages
  brew-change -v                # Show outdated packages with versions
  brew-change -a -b             # Show changelogs with breaking changes highlighted
  brew-change -b                # Same as -a -b (shorthand)
  brew-change -b node python    # Check specific packages for breaking changes
  brew-change --id-breaking     # Same as -a -b (long form)
  brew-change --version         # Show version information

EOF
}

# Pre-parse: extract flags that can be resolved without module sourcing.
# Everything else is deferred to full argument parsing after sourcing.
_PRE_PARSE_SHOW_HELP="false"
_PRE_PARSE_SHOW_VERSION="false"
_PRE_PARSE_HAS_EXPORT="false"
_PRE_PARSE_HAS_DRY_RUN="false"
_PRE_PARSE_HAS_UPGRADE="false"
_PRE_PARSE_HAS_EVIDENCE_MODE="false"
_PRE_PARSE_HAS_INVALID="false"
_PRE_PARSE_INVALID_OPT=""

for _arg in "${ORIGINAL_ARGS[@]}"; do
    case "$_arg" in
        -h|--help|help)
            _PRE_PARSE_SHOW_HELP="true"
            ;;
        --version)
            _PRE_PARSE_SHOW_VERSION="true"
            ;;
        export)
            _PRE_PARSE_HAS_EXPORT="true"
            ;;
        -n|--dry-run)
            _PRE_PARSE_HAS_DRY_RUN="true"
            ;;
        -u|--upgrade)
            _PRE_PARSE_HAS_UPGRADE="true"
            _PRE_PARSE_HAS_EVIDENCE_MODE="true"
            ;;
        -a|--all|-b|--id-breaking)
            _PRE_PARSE_HAS_EVIDENCE_MODE="true"
            ;;
        --fresh)
            # T3.2.2: evidence re-probe; only meaningful when evidence will
            # be gathered (validated below).
            ;;
        -v|--verbose|--dashboard|--plain) ;;
        -*)
            _PRE_PARSE_HAS_INVALID="true"
            _PRE_PARSE_INVALID_OPT="$_arg"
            ;;
        *)
            # A package argument gathers changelog evidence too.
            _PRE_PARSE_HAS_EVIDENCE_MODE="true"
            ;;
    esac
done

# Handle side-effect-free exits immediately
if [[ "$_PRE_PARSE_SHOW_HELP" == "true" ]]; then
    usage
    exit 0
fi

if [[ "$_PRE_PARSE_SHOW_VERSION" == "true" ]]; then
    echo "brew-change version $VERSION"
    exit 0
fi

# --dry-run without -u is invalid
if [[ "$_PRE_PARSE_HAS_DRY_RUN" == "true" && "$_PRE_PARSE_HAS_UPGRADE" == "false" ]]; then
    echo "Error: --dry-run requires --upgrade" >&2
    echo "Example: brew-change -u --dry-run" >&2
    exit 1
fi

# --fresh only matters when evidence will be gathered (T3.2.2)
for _arg in "${ORIGINAL_ARGS[@]}"; do
    if [[ "$_arg" == "--fresh" && "$_PRE_PARSE_HAS_EVIDENCE_MODE" == "false" ]]; then
        echo "Error: --fresh requires an evidence-gathering mode (-u, -a, -b, or a PACKAGE)" >&2
        echo "Example: brew-change -u --fresh" >&2
        exit 1
    fi
done
unset _arg

# Unknown option
if [[ "$_PRE_PARSE_HAS_INVALID" == "true" ]]; then
    echo "Error: Unknown option: $_PRE_PARSE_INVALID_OPT" >&2
    usage >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Set UTF-8 locale to handle emojis and special characters
# This must be set before any text processing
#
# The available-locale check greps a captured string, never a pipe: under
# `set -o pipefail`, `locale -a | grep -q` fails deterministically on macOS —
# grep -q exits on the first match, locale -a keeps writing, dies of SIGPIPE
# (141), and pipefail marks the pipeline failed — so the export was silently
# skipped on every run. With no ambient UTF-8 locale, the dashboard renderer
# falls back to per-render locale resolution, whose locale-variable resets
# (setlocale(3) via libintl -> CoreFoundation on macOS) are an intermittent
# bash segfault vector under load (the T2.6.2 full-CLI PTY stall).
# ---------------------------------------------------------------------------
_available_locales="$(locale -a 2>/dev/null || true)"
if grep -q "^en_US.UTF-8$" <<< "$_available_locales"; then
    export LC_ALL=en_US.UTF-8
    export LANG=en_US.UTF-8
elif grep -q "^C.UTF-8$" <<< "$_available_locales"; then
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
fi
unset _available_locales

# Source library functions
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Resolve the library directory. The script's own checkout wins: a repo
# run must use the checkout's libs, not a previously installed release
# (an installed copy without the checkout's new modules breaks sourcing,
# and stale installed libs silently mask checkout changes). Installed
# use resolves through the Cellar path, which contains lib/, so the
# brew-prefix lookup only serves unusual symlinked layouts.
if [[ -d "$SCRIPT_DIR/lib" ]]; then
    LIB_DIR="$SCRIPT_DIR/lib"
elif command -v brew &>/dev/null; then
    LIB_DIR="$(brew --prefix brew-change 2>/dev/null)/lib"
fi
readonly LIB_DIR

	source "$LIB_DIR/brew-change-config.sh"
	source "$LIB_DIR/brew-change-utils.sh"
	source "$LIB_DIR/brew-change-interactive.sh"
	source "$LIB_DIR/brew-change-breaking.sh"
	source "$LIB_DIR/brew-change-assessment.sh"
	source "$LIB_DIR/brew-change-github.sh"
	source "$LIB_DIR/brew-change-npm.sh"
	source "$LIB_DIR/brew-change-brew.sh"
	source "$LIB_DIR/brew-change-non-github.sh"
	source "$LIB_DIR/brew-change-display.sh"
	source "$LIB_DIR/brew-change-verdict.sh"
	source "$LIB_DIR/brew-change-parallel.sh"
	source "$LIB_DIR/brew-change-progress.sh"
	source "$LIB_DIR/brew-change-upgrade.sh"
	source "$LIB_DIR/brew-change-dashboard-ui.sh"
	source "$LIB_DIR/brew-change-export.sh"

# Verify dependencies
if ! verify_dependencies; then
    exit 1
fi

# Handle export command (must be after library sourcing for read_assessment_export)
if [[ "$_PRE_PARSE_HAS_EXPORT" == "true" ]]; then
    read_assessment_export
    exit $?
fi

# Pre-initialize GitHub auth token so subshells inherit it
init_github_auth
export GITHUB_AUTH_TOKEN

# ---------------------------------------------------------------------------
# Full argument parsing (after module sourcing for execution paths)
# ---------------------------------------------------------------------------
SHOW_ALL="false"
SHOW_VERSIONS="false"
IDENTIFY_BREAKING="false"
UPGRADE_MODE="false"
DRY_RUN_MODE="false"
DASHBOARD_MODE="false"
PLAIN_MODE="false"
FRESH_MODE="false"
PACKAGES=()

# Re-parse original arguments for full flag resolution
set -- "${ORIGINAL_ARGS[@]}"
while [[ $# -gt 0 ]]; do
    case $1 in
        -a|--all)
            SHOW_ALL="true"
            shift
            ;;
        -b|--id-breaking)
            IDENTIFY_BREAKING="true"
            shift
            ;;
        -u|--upgrade)
            UPGRADE_MODE="true"
            shift
            ;;
        -n|--dry-run)
            DRY_RUN_MODE="true"
            shift
            ;;
        --dashboard)
            # No-op since v1.14.0 (T2.6.2 flip): the dashboard is the
            # default for -u runs on a TTY. Kept as an accepted flag for
            # compatibility with the former opt-in rollout.
            DASHBOARD_MODE="true"
            shift
            ;;
        --plain)
            PLAIN_MODE="true"
            shift
            ;;
        --fresh)
            # T3.2.2: remove and recreate only the HTTP response cache
            # before evidence gathering (see the pre-gather block below).
            FRESH_MODE="true"
            shift
            ;;
        -v|--verbose)
            SHOW_VERSIONS="true"
            shift
            ;;
        -h|--help|help)
            # Already handled in pre-parse; unreachable here
            shift
            ;;
        --version)
            # Already handled in pre-parse; unreachable here
            shift
            ;;
        *)
            PACKAGES+=("$1")
            shift
            ;;
    esac
done

# ---------------------------------------------------------------------------
# T2.6.2 default flip (research-004 §3.2/§4): for -u runs on a TTY the
# interactive dashboard is now the default view. Precedence (escape hatch
# first, per research-004 §3.3): --plain flag > BREW_CHANGE_PLAIN=1 env >
# default dashboard. --dashboard / BREW_CHANGE_DASHBOARD=1 are accepted
# no-ops (the dashboard is already the default). The view applies only to
# interactive -u runs: non-TTY runs keep today's plain, deterministic
# behavior regardless of flags (piped contract is inviolable, §3.1).
VIEW_USE_DASHBOARD="false"
if [[ "$PLAIN_MODE" == "true" || "${BREW_CHANGE_PLAIN:-}" == "1" ]]; then
    VIEW_USE_DASHBOARD="false"
elif [[ -t 1 ]]; then
    VIEW_USE_DASHBOARD="true"
fi
if [ ${#PACKAGES[@]} -gt 0 ]; then
    # Show changelog for specific package(s)
    export IDENTIFY_BREAKING  # Make breaking flag available to subprocesses

    # Soft warning at 10+ packages
    if [ ${#PACKAGES[@]} -gt 10 ]; then
        echo "Note: ${#PACKAGES[@]} packages specified. For all outdated packages, consider: brew-change -a"
        echo ""
    fi

    # Process single package through existing resolution logic for backward compat
    if [ ${#PACKAGES[@]} -eq 1 ]; then
        PACKAGE="${PACKAGES[0]}"
        if check_package_exists "$PACKAGE"; then
            echo "Processing changelog for 1 package..."
            echo ""
            show_package_changelog "$PACKAGE"
        else
            # Package doesn't exist, check for naming conflicts
            conflicting_packages=""
            if command -v jq >/dev/null 2>&1; then
                # Look for packages that contain the searched name using grep
                conflicting_packages=$(brew outdated --json=v2 2>/dev/null | jq -r '.formulae[] | .name' 2>/dev/null | grep -F -e "$PACKAGE" | sort | uniq || true)

                # Also check for exact matches with word boundaries
                exact_matches=$(brew outdated --json=v2 2>/dev/null | jq -r '.formulae[] | .name' 2>/dev/null | grep -F -w -e "$PACKAGE" | sort | uniq || true)

                if [[ -n "$exact_matches" ]]; then
                    # Prefer exact matches over partial matches
                    conflicting_packages="$exact_matches"
                fi
            fi

            # If we found packages with similar names, present a choice
            if [[ -n "$conflicting_packages" ]]; then
                package_count=$(echo "$conflicting_packages" | wc -l | tr -d ' ')
                if [[ "$package_count" -gt 1 ]]; then
                    echo "Multiple packages found matching '$PACKAGE':"
                    echo ""
                    echo "$conflicting_packages" | while read -r pkg; do
                        echo "  • $pkg"
                    done
                    echo ""

                    # Check if the original package name is in the list
                    exact_match=""
                    if echo "$conflicting_packages" | grep -q "^${PACKAGE}$"; then
                        exact_match="$PACKAGE"
                    fi

                    # If exact match exists, use it; otherwise show interactive prompt
                    if [[ -n "$exact_match" ]]; then
                        echo "Using exact match: $exact_match"
                        PACKAGE="$exact_match"
                        echo "Processing changelog for 1 package..."
                        echo ""
                        show_package_changelog "$PACKAGE"
                    else
                        echo "Please specify which package you want:"
                        echo "$conflicting_packages" | paste -sd "," -
                        echo ""
                        exit 1
                    fi
                elif [[ "$package_count" -eq 1 ]]; then
                    # Use the single found package
                    PACKAGE="$conflicting_packages"
                    echo "Using package: $PACKAGE"
                    echo "Processing changelog for 1 package..."
                    echo ""
                    show_package_changelog "$PACKAGE"
                fi
            else
                # No conflicts found, show standard error message
                echo "Error: Package '$PACKAGE' not found in Homebrew"
                echo ""
                # Check for similar packages if package is long enough.
                # The suggestion list itself is shown in non-interactive mode
                # too (T3.1.2): users never need to construct a shell
                # pipeline like 'brew list | grep'.
                suggestions=""
                if command -v jq >/dev/null 2>&1; then
                    suggestions="$(find_similar_packages "$PACKAGE" 2>/dev/null || true)"
                fi
                if [[ -n "$suggestions" ]]; then
                    echo "$suggestions"
                    echo ""
                    # Check if running interactively
                    if is_interactive_mode; then
                        best_suggestion=""
                        if best_suggestion=$(get_best_suggestion "$PACKAGE" 2>/dev/null); then
                            if prompt_for_confirmation "Continue with '$best_suggestion'? (y/N): "; then
                                echo ""
                                echo "Processing changelog for 1 package..."
                                echo ""
                                show_package_changelog "$best_suggestion"
                            fi
                        fi
                    else
                        # Non-interactive mode: point at the exact names above
                        echo "Run 'brew-change <package>' with the exact name from the list above."
                    fi
                else
                    echo "No similar installed packages found."
                    echo "Search Homebrew for the exact name with: brew search $PACKAGE"
                fi
            fi
            exit 1
        fi
    else
        # Multiple packages: process sequentially with separators
        echo "Processing changelogs for ${#PACKAGES[@]} packages..."
        echo ""

        had_errors=0
        for i in "${!PACKAGES[@]}"; do
            pkg="${PACKAGES[$i]}"

            # Add separator between packages
            if [[ $i -gt 0 ]]; then
                echo "---"
            fi

            if check_package_exists "$pkg"; then
                show_package_changelog "$pkg"
            else
                echo "Error: Package '$pkg' not found in Homebrew"
                had_errors=1
            fi
        done

        if [[ "$had_errors" -eq 1 ]]; then
            exit 1
        fi
    fi
else
    # Get outdated packages
    outdated_packages=""
    if ! outdated_packages=$(brew outdated --json=v2 2>/dev/null | grep -v '✔︎ JSON API'); then
        echo "Error: Unable to check for outdated packages"
        exit 1
    fi

    # Check if there are any outdated packages
    formulae_empty=""
    casks_empty=""

    if formulae_empty=$(echo "$outdated_packages" | jq -r '.formulae | length' 2>/dev/null); then
        if [[ "$formulae_empty" == "0" ]]; then
            if casks_empty=$(echo "$outdated_packages" | jq -r '.casks | length' 2>/dev/null); then
                if [[ "$casks_empty" == "0" ]]; then
                    echo "No outdated packages found."
                    exit 0
                fi
            else
                # If casks check fails, just check formulae
                if [[ "$formulae_empty" == "0" ]]; then
                    echo "No outdated packages found."
                    exit 0
                fi
            fi
        fi
    fi

    # If -b is used without -a, implicitly enable -a
    if [ "$IDENTIFY_BREAKING" = "true" ] && [ "$SHOW_ALL" = "false" ]; then
        SHOW_ALL="true"
    fi

    # If -u is used, implicitly enable -a and -b
    if [ "$UPGRADE_MODE" = "true" ]; then
        SHOW_ALL="true"
        IDENTIFY_BREAKING="true"
    fi

    # Export dry-run mode for subprocesses
    if [ "$DRY_RUN_MODE" = "true" ]; then
        export DRY_RUN_MODE
    fi

    if [ "$SHOW_ALL" = "true" ]; then
        # Count total outdated packages
        total_packages=0
        if formulae_count=$(echo "$outdated_packages" | jq -r '.formulae | length' 2>/dev/null); then
            total_packages=$((total_packages + formulae_count))
        fi
        if casks_count=$(echo "$outdated_packages" | jq -r '.casks | length' 2>/dev/null); then
            total_packages=$((total_packages + casks_count))
        fi

        # First show the outdated packages list like brew outdated -v
        echo "Outdated packages:"
        brew outdated -v

        # Ask for confirmation before showing detailed changelogs
        # Skip for upgrade mode (-u) or single package — auto-proceed
        echo ""
        if [[ $total_packages -eq 1 ]] || [[ "$UPGRADE_MODE" == "true" ]]; then
            echo ""
            echo "Processing changelog for $total_packages outdated package(s)..."
        else
            # Check if running interactively
            if is_interactive_mode; then
                if ! prompt_for_confirmation "Found $total_packages outdated packages. Would you like to see detailed changelog information? (y/N) "; then
                    echo "Run 'brew upgrade' to upgrade all packages, or 'brew upgrade <package>' for individual packages."
                    exit 0
                fi
            else
                # Non-interactive mode (piped input): proceed without confirmation
                echo "Found $total_packages outdated packages. Processing..."
            fi
        fi
        echo ""
        # Process packages in parallel
        # Note: outdated_packages is passed as argument to process_packages_parallel, no export needed
        export IDENTIFY_BREAKING  # Make breaking flag available to subprocesses
        export BREW_CHANGE_PARALLEL_MODE="true"  # Disable interactive prompts in parallel mode

        # If upgrade mode, create a tracking directory for breaking-change status
        if [[ "$UPGRADE_MODE" == "true" ]]; then
            UPGRADE_STATUS_DIR=$(mktemp -d -t brew-change-status.XXXXXX 2>/dev/null)
            export UPGRADE_STATUS_DIR
            register_temp_dir "$UPGRADE_STATUS_DIR"
            # Inventory stage: emit one initial assessment record per outdated
            # package into the per-run status dir (T2.1.2 record contract).
            assessment_record_init "$UPGRADE_STATUS_DIR" "$outdated_packages"

            # T3.1.1 first-run guidance: one concise hint on interactive
            # dashboard runs only (VIEW_USE_DASHBOARD already excludes
            # piped runs, --plain, and BREW_CHANGE_PLAIN=1). STDERR only —
            # stdout byte-purity of piped/dashboard output is inviolable —
            # printed before the progress renderer owns the status line.
            # Non-persistent by design: no state files, no per-run marker,
            # so every interactive dashboard run shows it.
            if [[ "$VIEW_USE_DASHBOARD" == "true" ]]; then
                printf 'New here? brew-change checks outdated packages, shows what changed, and only upgrades what you approve — nothing runs until you confirm.\n' >&2
            fi

            # T2.4.3: live progress UI during evidence/classify. The renderer
            # is the only code that draws terminal frames; the start/stop
            # lifecycle lives in lib/brew-change-progress.sh so the dashboard
            # refresh pass reuses the identical animation.
            progress_renderer_start
        fi

        # tasks-004 Task 1: plain -b runs (no -u) reuse the assessment
        # record pipeline so the run can end with an honest verdict
        # summary. Workers already gate their evidence-row, provenance,
        # and brew-info memo writes on UPGRADE_STATUS_DIR, so giving -b
        # its own status dir activates exactly the -u recording path —
        # no renderer, no dashboard, and changelogs keep streaming.
        if [[ "$UPGRADE_MODE" != "true" && "$IDENTIFY_BREAKING" == "true" ]]; then
            UPGRADE_STATUS_DIR=$(mktemp -d -t brew-change-status.XXXXXX 2>/dev/null)
            export UPGRADE_STATUS_DIR
            register_temp_dir "$UPGRADE_STATUS_DIR"
            assessment_record_init "$UPGRADE_STATUS_DIR" "$outdated_packages"
        fi

        # Dashboard quiet-changelogs: when the interactive dashboard will own
        # the terminal for this run, suppress the inline per-package
        # changelog dump before evidence gathering starts (the dashboard's
        # r-Review shows the recorded evidence on demand). Workers inherit
        # the export; evidence recording is never affected. Default (unset)
        # keeps the dump for plain -u and all non-dashboard modes.
        if [[ "$VIEW_USE_DASHBOARD" == "true" ]]; then
            export BREW_CHANGE_CHANGELOG_OUTPUT=0
        fi

        # With the live renderer active, the completion summary must not
        # print from inside process_packages_parallel: the renderer owns the
        # status line until it is stopped below. Defer the line and flush it
        # after the stop so the summary starts on a fresh terminal line.
        if [[ -n "${PROGRESS_RENDERER_PID:-}" ]]; then
            BREW_CHANGE_DEFER_SUMMARY=1
        fi

        # T3.2.2 evidence re-entry (research-008): --fresh removes and
        # recreates ONLY the HTTP response cache (github-patterns, brew-info
        # caches, and unrelated state are preserved, and stale fallback is
        # impossible because old entries are gone); pruning enforces the
        # 512-entry / 100 MiB budgets on that namespace only; the run-scoped
        # cache-events directory receives one uniquely named file per cache
        # serve so subshells and parallel workers need no shared counters.
        if [[ "$FRESH_MODE" == "true" ]]; then
            if ! http_cache_reset_fresh; then
                echo "Warning: --fresh cache reset failed; continuing with existing cache" >&2
            fi
        fi
        http_cache_prune || true
        if [[ "$UPGRADE_MODE" == "true" ]]; then
            export BREW_CHANGE_HTTP_CACHE_EVENTS="${BREW_CHANGE_HTTP_CACHE_EVENTS:-$UPGRADE_STATUS_DIR/http-cache-events}"
            mkdir -p "$BREW_CHANGE_HTTP_CACHE_EVENTS" 2>/dev/null || true
        fi

        process_packages_parallel "$outdated_packages" "$PARALLEL_JOBS"
        BREW_CHANGE_DEFER_SUMMARY=0

        if [[ "$UPGRADE_MODE" == "true" ]]; then
            # Build canonical inventory token list for evidence collection.
            # This ensures every package gets exactly one classification outcome.
            # Note: cannot use 'local' at top level; these are plain variables.
            inventory_tokens=()
            while IFS=$'\t' read -r pkg _ptype; do
                [[ -n "$pkg" && "$pkg" != "null" ]] && inventory_tokens+=("$pkg")
            done < <(extract_outdated_package_tokens "$outdated_packages" 2>/dev/null)

            # Collect evidence and classify with missing-row synthesis
            classify_upgrade_evidence "$UPGRADE_STATUS_DIR" "${inventory_tokens[@]+"${inventory_tokens[@]}"}"

            # Write assessment export for external consumers (tasks-005)
            # This happens after classification but before dashboard/prompt
            # so the export is available even if the user quits.
            write_assessment_export "$UPGRADE_STATUS_DIR/assessment.jsonl" || true

            # T2.4.3: the renderer must terminate BEFORE any prompt or
            # dashboard output is drawn. classify_upgrade_evidence has just
            # written the final stage events, so the renderer satisfies its
            # total+idle contract on its own; progress_renderer_stop drops
            # the sentinel, waits a bounded time, cancels as a backstop, and
            # clears the status line.
            progress_renderer_stop

            # Deferred completion summary from process_packages_parallel:
            # printed only now that the renderer is stopped and its line is
            # cleared, so it can never share a line with a spinner frame.
            if [[ -n "${PARALLEL_PENDING_SUMMARY:-}" ]]; then
                printf '%s\n' "$PARALLEL_PENDING_SUMMARY"
                PARALLEL_PENDING_SUMMARY=""
            fi

            # T2.6.2 default flip (research-004 §3.2/§4): for TTY runs the
            # dashboard is the default -u view; --plain / BREW_CHANGE_PLAIN=1
            # restore the previous prompt flow. Piped runs always take the
            # plain prompt flow (which exits without prompting) — the view
            # resolution above already required a TTY.
            if [[ "$VIEW_USE_DASHBOARD" == "true" ]] \
                && declare -F run_dashboard_mode >/dev/null 2>&1; then
                run_dashboard_mode "$UPGRADE_STATUS_DIR/assessment.jsonl"
            else
                run_upgrade_prompt "$outdated_packages"
            fi
        else
            # tasks-004 Task 1: verdict summary for plain -b runs. Same
            # stage boundary as -u (consolidate + classify + synthesize
            # missing rows); the renderer is pure stdout and is skipped
            # entirely when no records were produced. A classification
            # failure must not lose the run's output — warn on stderr and
            # continue to the generic hint.
            if [[ "$IDENTIFY_BREAKING" == "true" && -n "${UPGRADE_STATUS_DIR:-}" ]]; then
                inventory_tokens=()
                while IFS=$'\t' read -r pkg _ptype; do
                    [[ -n "$pkg" && "$pkg" != "null" ]] && inventory_tokens+=("$pkg")
                done < <(extract_outdated_package_tokens "$outdated_packages" 2>/dev/null)

                if classify_upgrade_evidence "$UPGRADE_STATUS_DIR" "${inventory_tokens[@]+"${inventory_tokens[@]}"}"; then
                    # Write assessment export for external consumers (tasks-005)
                    write_assessment_export "$UPGRADE_STATUS_DIR/assessment.jsonl" || true

                    verdict_block=$(render_verdict_summary "$UPGRADE_STATUS_DIR/assessment.jsonl")
                    if [[ -n "$verdict_block" ]]; then
                        printf '\n%s\n\n' "$verdict_block"
                    fi
                else
                    echo "Warning: verdict summary unavailable for this run" >&2
                fi
            fi
            echo "Run 'brew upgrade' to upgrade all packages, or 'brew upgrade <package>' for individual packages."
        fi
    elif [ "$SHOW_VERSIONS" = "true" ]; then
        # Show list with versions like brew outdated -v
        show_outdated_with_versions
    else
        # Show simple list like brew outdated (package names only)
        show_outdated_simple_names
    fi
fi
